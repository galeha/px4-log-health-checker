    ,{"pattern": "^successfully created (.+) data writer, topic id: ([0-9]+)$", "replacement": "XRCE-DDS 已创建数据发布端：\\1（主题 ID：\\2）"}
    ,{"pattern": "^(?:\\[BGarage\\])?:?\\s*Custom(?:ized)? Landing\\.?$", "replacement": "执行自定义降落（第三方模块消息）"}
