    ,{"pattern": "^logging: opening log file .*$", "replacement": "打开新的飞行日志文件"}
    ,{"pattern": "^closed logfile, bytes written: .*$", "replacement": "飞行日志文件已关闭"}
    ,{"pattern": ".*offset committed:.*", "replacement": "传感器偏置更新已保存"}
    ,{"pattern": ".*EST:[0-9]+ offset:.*", "replacement": "传感器在线偏置已更新"}
    ,{"pattern": ".*timestamp error.*", "replacement": "传感器采样时间戳异常"}
    ,{"pattern": "^Configured primary gimbal control.*$", "replacement": "已配置主云台控制链路"}
    ,{"pattern": "^GIMBAL_MANAGER_PITCHYAW .* denied.*$", "replacement": "云台俯仰/偏航控制请求被拒绝"}
    ,{"pattern": "^Start file log \\(type: ([^)]+)\\)$", "replacement": "开始文件日志记录（类型：\\1）"}
    ,{"pattern": "^using network interface .*$", "replacement": "MAVLink 已启用网络接口"}
    ,{"pattern": "^Accel ([0-9]+) clipping, not safe to fly!$", "replacement": "加速度计 \\1 测量超过量程，飞行不安全！"}
    ,{"pattern": "^Gyro ([0-9]+) clipping, not safe to fly!$", "replacement": "陀螺仪 \\1 测量超过量程，飞行不安全！"}
    ,{"pattern": "^primary EKF changed ([0-9]+) \\(filter fault\\) -> ([0-9]+)$", "replacement": "主 EKF 因滤波器故障从实例 \\1 切换到实例 \\2"}
    ,{"pattern": "^Opened full log file: .+$", "replacement": "已打开完整飞行日志文件"}
    ,{"pattern": "^(?:\\[logger\\]\\s*)?(?:\\./|/).+\\.ulg$", "replacement": "当前飞行日志文件路径已确定"}
    ,{"pattern": "^with netmask: (.+)$", "replacement": "MAVLink 网络子网掩码：\\1"}
